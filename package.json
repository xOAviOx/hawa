{
  "name": "hawa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "HAWA — play music in the air with your hands, 100% in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "setup:assets": "node scripts/setup-assets.mjs",
    "postinstall": "node scripts/setup-assets.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "tone": "^15.1.22"
  }
}
